# Copy to .env.local and fill in for local dev (`vercel env pull .env.local`
# does this automatically for the Vercel-managed ones below).

# Public (client bundle) - which signed-in accounts see the /admin area.
# Must match ADMIN_EMAILS below.
VITE_ADMIN_EMAILS=you@example.com

# Server-only (Vercel project env vars, NOT prefixed with VITE_):

# Added automatically once you click "Connect to Project" on the Blob store
# (see Storage -> juowmusic -> Connect to Project in the Vercel dashboard).
BLOB_READ_WRITE_TOKEN=

# Which signed-in accounts /api/blob-upload will issue upload tokens to.
# Must match VITE_ADMIN_EMAILS above.
ADMIN_EMAILS=you@example.com
