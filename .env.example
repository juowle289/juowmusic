# Copy to .env.local and fill in for local dev (`vercel env pull .env.local`
# does this automatically for the Vercel-managed ones below).

# Public (client bundle) - which signed-in accounts see the /admin area.
# Must match ADMIN_EMAILS below.
VITE_ADMIN_EMAILS=you@example.com

# Server-only (Vercel project env vars, NOT prefixed with VITE_):

# Added automatically once you click "Connect to Project" on the Blob store
# (see Storage -> juowmusic -> Connect to Project in the Vercel dashboard).
BLOB_READ_WRITE_TOKEN=

# Which signed-in accounts /api/blob-upload (and the other /api/admin-*
# functions) will treat as an admin. Must match VITE_ADMIN_EMAILS above.
ADMIN_EMAILS=you@example.com

# Only needed for the admin Users tab (/api/admin-list-users,
# /api/admin-set-user-disabled). Firebase Console -> Project Settings ->
# Service Accounts -> Generate new private key - paste the ENTIRE downloaded
# JSON file's content here as one value (it'll have its own quotes/braces,
# that's fine). This key can do anything in the Firebase project, so only
# ever set it as a server-side Vercel env var, never VITE_-prefixed.
FIREBASE_SERVICE_ACCOUNT_KEY=
